# ---------------------------------------------------------------------------
# Banco de dados (obrigatório)
# Use a connection string do POOLER do Supabase (porta 6543) ou do Neon.
# Serverless abre e fecha conexões o tempo todo; a porta 5432 direta esgota.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Sessão (obrigatório) - mínimo 32 caracteres
# Gere com: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=troque-por-48-caracteres-aleatorios-de-verdade-aqui

# ---------------------------------------------------------------------------
# Webhook do provedor de pagamento (opcional enquanto a cobrança for Pix
# manual). Sem ele, POST /api/payments/webhook responde 503.
# ---------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cron. No Vercel, defina como variável de ambiente do projeto: o cron envia
# esse valor em Authorization: Bearer.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Cifra dos tokens digitados em Configurações › Integrações (recomendado).
# Sem ela, tokens só podem vir das variáveis abaixo. Trocar esta chave
# invalida os tokens já salvos pelo painel (será preciso digitá-los de novo).
# Gere com: openssl rand -base64 32
# ---------------------------------------------------------------------------
INTEGRATIONS_ENCRYPTION_KEY=

# Endereço público do site: o agente de IA manda este link para reservar.
SITE_URL=

# ---------------------------------------------------------------------------
# Meta: anúncios, WhatsApp Cloud API e Instagram Direct (todos opcionais).
# Tudo isto também pode ser preenchido em Configurações › Integrações; o que
# estiver salvo lá vale mais que a variável, campo a campo.
# ---------------------------------------------------------------------------
# Versão fixa da Graph API (confira a vigente em developers.facebook.com).
META_GRAPH_VERSION=v23.0
# Segredo do app (Configurações > Básico). Assina os webhooks.
META_APP_ID=
META_APP_SECRET=
# Texto livre (16+ caracteres) que você digita ao cadastrar o webhook na Meta.
META_WEBHOOK_VERIFY_TOKEN=

# Métricas de anúncios: token de usuário do sistema com ads_read.
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000

# Instagram Direct: página do Facebook ligada ao Instagram profissional.
# Token da página com instagram_manage_messages e pages_messaging.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=

# WhatsApp: "meta" envia pela Cloud API; "simulado" grava sem enviar e libera
# o simulador no painel. Vazio = envio desligado.
WHATSAPP_PROVIDER=simulado
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Agente de IA (Claude). O modo e as instruções se configuram no painel; a
# chave também pode ser colada lá em vez de ficar aqui.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Usados APENAS por `npm run seed:admins`. Não são lidos pela aplicação e não
# devem ir para as variáveis do Vercel.
# ---------------------------------------------------------------------------
ADMIN_1_USERNAME=LuciaArcoverdeFlt
ADMIN_1_EMAIL=admin1@example.com
ADMIN_1_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
ADMIN_2_USERNAME=VictorFerrFlt
ADMIN_2_EMAIL=admin2@example.com
ADMIN_2_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
