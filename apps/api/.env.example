NODE_ENV=development
PORT=4000
# Cole aqui a connection string PostgreSQL do Supabase.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:3000
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
# Used only by scripts/seed-admins.ts. Never commit real values.
