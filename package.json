{
  "name": "carneiros-flat-booking",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test": "npm --workspace apps/web run test",
    "db:migrate": "node --env-file-if-exists=apps/web/.env.local scripts/migrate.mjs",
    "seed:admins": "node --env-file-if-exists=apps/web/.env.local scripts/seed-admins.mjs",
    "promote:admin": "node --env-file-if-exists=apps/web/.env.local scripts/promote-admin.mjs",
    "db:smoke": "node --env-file-if-exists=apps/web/.env.local scripts/smoke.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "pg": "^8.13.1"
  }
}
